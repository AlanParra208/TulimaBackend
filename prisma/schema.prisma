generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model categoria {
  id_categoria      Int                 @id @default(autoincrement())
  nombre            String              @db.VarChar(50)
  destino_turistico destino_turistico[]
  evento            evento[]
  hotel             hotel[]             @relation("categoria_relacion")
  restaurante       restaurante[]
}

model destino_turistico {
  id_destino     Int        @id @default(autoincrement())
  id_municipio   Int
  nombre         String?    @db.VarChar(100)
  numero_Calle   Int?
  nombre_Calle   String     @db.VarChar(50)
  codifoPostal   Int
  horarioAbierto DateTime?  @db.Time(0)
  horarioCerrado DateTime?  @db.Time(0)
  estadoConvenio Boolean
  id_categoria   Int
  imagen         String?    @db.Text
  activo         Boolean    @default(true)
  id_usuario     Int?
  categoria      categoria  @relation(fields: [id_categoria], references: [id_categoria], onUpdate: Restrict, map: "destino_turistico_categoria_FK")
  municipio      municipio  @relation(fields: [id_municipio], references: [id_municipio], onUpdate: Restrict, map: "destino_turistico_municipio_FK")
  usuario        usuario?   @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "destino_turistico_usuario_FK")
  evento         evento[]
  favoritos      Favorito[]

  @@index([id_categoria], map: "destino_turistico_categoria_FK")
  @@index([id_municipio], map: "destino_turistico_municipio_FK")
  @@index([id_usuario], map: "destino_turistico_usuario_FK")
}

model evento {
  id_evento         Int               @id @default(autoincrement())
  id_destino        Int
  nombre_Evento     String            @db.VarChar(50)
  numero_Calle      Int
  nombre_Calle      String            @db.VarChar(50)
  codigoPostal      Int
  id_municipio      Int
  tipoEvento        String?           @db.VarChar(50)
  fechaInicio       DateTime          @db.DateTime(0)
  disponibilidad    String?           @db.VarChar(100)
  fechaTermino      DateTime          @db.DateTime(0)
  id_categoria      Int
  activo            Boolean           @default(true)
  id_usuario        Int?
  categoria         categoria         @relation(fields: [id_categoria], references: [id_categoria], onUpdate: Restrict, map: "evento_categoria_FK")
  destino_turistico destino_turistico @relation(fields: [id_destino], references: [id_destino], onUpdate: Restrict, map: "evento_destino_turistico_FK")
  usuario           usuario?          @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "evento_usuario_FK")

  @@index([id_categoria], map: "evento_categoria_FK")
  @@index([id_destino], map: "evento_destino_turistico_FK")
  @@index([id_usuario], map: "evento_usuario_FK")
}

model hotel {
  id_hotel           Int        @id @default(autoincrement())
  nombre_hotel       String     @db.VarChar(25)
  numero_Calle       Int
  nombre_Calle       String     @db.VarChar(50)
  codigoPostal       Int
  id_municipio       Int
  disponibilidad     Int?
  categoria          String?    @db.VarChar(20)
  telefono           BigInt?
  email              String?    @db.VarChar(50)
  estadoConvenio     Boolean
  id_categoria       Int
  imagen             String?    @db.Text
  descripcion        String?    @db.VarChar(255)
  activo             Boolean    @default(true)
  id_usuario         Int?
  favoritos          Favorito[]
  categoria_relacion categoria  @relation("categoria_relacion", fields: [id_categoria], references: [id_categoria], onUpdate: Restrict, map: "hotel_categoria_FK")
  municipio          municipio  @relation(fields: [id_municipio], references: [id_municipio], onUpdate: Restrict, map: "hotel_municipio_FK")
  usuario            usuario?   @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "hotel_usuario_FK")

  @@index([id_categoria], map: "hotel_categoria_FK")
  @@index([id_municipio], map: "hotel_municipio_FK")
  @@index([id_usuario], map: "hotel_usuario_FK")
}

model municipio {
  id_municipio      Int                 @id @default(autoincrement())
  nombre            String              @db.VarChar(25)
  url_imagen        String?             @db.Text
  descripcion       String?             @db.Text
  destino_turistico destino_turistico[]
  hotel             hotel[]
  provedor_tour     provedor_tour[]
  restaurante       restaurante[]
}

model provedor_tour {
  id_provedor    Int        @id @default(autoincrement())
  nombre         String     @db.VarChar(30)
  tipoTour       String?    @db.VarChar(20)
  telefono       BigInt?
  tipoServicio   String?    @db.VarChar(50)
  estadoConvenio Boolean
  imagen         String?    @db.Text
  id_municipio   Int
  activo         Boolean    @default(true)
  id_usuario     Int?
  favoritos      Favorito[]
  municipio      municipio  @relation(fields: [id_municipio], references: [id_municipio], onUpdate: Restrict, map: "provedor_tour_municipio_FK")
  usuario        usuario?   @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "provedor_tour_usuario_FK")

  @@index([id_municipio], map: "provedor_tour_municipio_FK")
  @@index([id_usuario], map: "provedor_tour_usuario_FK")
}

model restaurante {
  id_restaurante Int        @id @default(autoincrement())
  nombre         String     @db.VarChar(50)
  tipo           String?    @db.VarChar(100)
  numero_Calle   Int
  nombre_Calle   String     @db.VarChar(50)
  codigoPostal   Int
  id_municipio   Int
  disponibilidad String?    @db.VarChar(100)
  telefono       BigInt?
  email          String?    @db.VarChar(50)
  estadoConvenio Boolean
  id_categoria   Int
  imagen         String?    @db.Text
  horarioAbierto DateTime?  @db.Time(0)
  horarioCerrado DateTime?  @db.Time(0)
  activo         Boolean    @default(true)
  id_usuario     Int?
  favoritos      Favorito[]
  categoria      categoria  @relation(fields: [id_categoria], references: [id_categoria], onUpdate: Restrict, map: "restaurante_categoria_FK")
  municipio      municipio  @relation(fields: [id_municipio], references: [id_municipio], onUpdate: Restrict, map: "restaurante_municipio_FK")
  usuario        usuario?   @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "restaurante_usuario_FK")

  @@index([id_categoria], map: "restaurante_categoria_FK")
  @@index([id_municipio], map: "restaurante_municipio_FK")
  @@index([id_usuario], map: "restaurante_usuario_FK")
}

model suscripcion {
  id_suscripcion    Int      @id @default(autoincrement())
  id_usuario        Int
  fechaPago         DateTime @db.DateTime(0)
  fechaFinalizacion DateTime @db.DateTime(0)
  usuario           usuario  @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict, map: "suscripcion_usuario_FK")

  @@index([id_usuario], map: "suscripcion_usuario_FK")
}

model usuario {
  id_usuario        Int                 @id @default(autoincrement())
  primerNombre      String              @db.VarChar(50)
  segundoNombre     String?             @db.VarChar(50)
  apellidoPaterno   String              @db.VarChar(50)
  apellidoMaterno   String?             @db.VarChar(50)
  contrase_a        String?             @map("contraseña") @db.VarChar(255)
  nombreUsuario     String              @db.VarChar(15)
  telefono          String?             @db.VarChar(255)
  genero            String?             @db.VarChar(50)
  edad              Int?
  rol               String              @db.VarChar(15)
  correo            String?             @unique @db.VarChar(100)
  googleId          String?             @unique @db.VarChar(255)
  activo            Boolean             @default(true)
  mfaEnabled        Boolean             @default(false)
  mfaSecret         String?             @db.VarChar(255)
  rfc               String?             @db.VarChar(13)
  destino_turistico destino_turistico[]
  evento            evento[]
  favoritos         Favorito[]
  hotel             hotel[]
  provedor_tour     provedor_tour[]
  restaurante       restaurante[]
  suscripcion       suscripcion[]
}

model Favorito {
  id_favorito       Int                @id @default(autoincrement())
  id_usuario        Int
  id_hotel          Int?
  id_restaurante    Int?
  id_destino        Int?
  id_provedor_tour  Int?
  destino_turistico destino_turistico? @relation(fields: [id_destino], references: [id_destino], onDelete: Cascade)
  hotel             hotel?             @relation(fields: [id_hotel], references: [id_hotel], onDelete: Cascade)
  provedor_tour     provedor_tour?     @relation(fields: [id_provedor_tour], references: [id_provedor], onDelete: Cascade)
  restaurante       restaurante?       @relation(fields: [id_restaurante], references: [id_restaurante], onDelete: Cascade)
  usuario           usuario            @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@unique([id_usuario, id_hotel])
  @@unique([id_usuario, id_restaurante])
  @@unique([id_usuario, id_destino])
  @@unique([id_usuario, id_provedor_tour])
  @@index([id_destino], map: "favoritos_id_destino_fkey")
  @@index([id_hotel], map: "favoritos_id_hotel_fkey")
  @@index([id_provedor_tour], map: "favoritos_id_provedor_tour_fkey")
  @@index([id_restaurante], map: "favoritos_id_restaurante_fkey")
  @@map("favoritos")
}
